{
  "name": "@keleus/deepseek-pet",
  "version": "0.2.1",
  "private": false,
  "description": "DeepSeek Pet plugin: an interactive, state-aware companion embedded in DeepSeek Harness Web",
  "type": "module",
  "icon": "./icon.webp",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "assets": "python3 scripts/build_assets.py && node scripts/embed-assets.mjs",
    "build": "npm run assets && node scripts/build.mjs",
    "test": "node --test tests/unit/*.test.js",
    "test:visual:build": "esbuild tests/visual/fixture.jsx --bundle --outfile=tests/visual/fixture.bundle.js --format=iife --platform=browser --jsx=automatic"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "live2d",
    "desktop-pet",
    "deepseek-pet"
  ],
  "author": {
    "name": "keleus",
    "email": "jen.hs@outlook.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/keleus/deepseek-pet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keleus/deepseek-pet.git"
  },
  "bugs": {
    "url": "https://github.com/keleus/deepseek-pet/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-layout": "*",
    "@deepseek-ai/dsh-client-ui-session": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-ui-workspace": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-ui-conversation": { "optional": true },
    "@deepseek-ai/dsh-client-ui-layout": { "optional": true },
    "@deepseek-ai/dsh-client-ui-session": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-client-ui-workspace": { "optional": true }
  },
  "devDependencies": {
    "esbuild": "^0.25.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.webp",
    "docs/deepseek-pet-preview.png"
  ],
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.1.7-0"
  }
}
